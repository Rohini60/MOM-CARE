rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test doc (used in connection validation)
    match /test/connection {
      allow read: if true;
    }

    // User profile: only the owner can read, create, update, or delete
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && incoming().id == userId;
      allow update: if isOwner(userId) && incoming().id == userId;
      allow delete: if isOwner(userId);

      // Subcollections under users - strictly private to user
      match /checkins/{checkinId} {
        allow read, write: if isOwner(userId);
      }

      match /symptoms/{symptomId} {
        allow read, write: if isOwner(userId);
      }

      match /care_tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /appointments/{appointmentId} {
        allow read, write: if isOwner(userId);
      }

      match /medications/{medicationId} {
        allow read, write: if isOwner(userId);
      }

      match /medical_reports/{reportId} {
        allow read, write: if isOwner(userId);
      }

      match /ai_conversations/{conversationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Community posts: readable by all users, authenticated author can create/update/delete
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        (existing().authorId == request.auth.uid && incoming().authorId == request.auth.uid) ||
        // Allow updating likesCount or commentsCount
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount'])
      );
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && existing().authorId == request.auth.uid;
      }
    }

    // Moderation reports: signed in users can create
    match /community_reports/{reportId} {
      allow create: if isSignedIn() && incoming().reportedBy == request.auth.uid;
      allow read: if false; // Only admin/backend
    }
  }
}
